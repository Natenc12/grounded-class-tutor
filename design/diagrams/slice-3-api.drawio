        <object id="scope" label="&lt;div style=&quot;font-size:20px;font-weight:700;line-height:1.25&quot;&gt;Retrieval guarantees&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:7px&quot;&gt;Filter owner_id AND class_id. Model ID mismatch fails explicitly.&lt;br&gt;Top-k similarity scores are carried through; no relevance-score gate.&lt;br&gt;Empty corpus skips query embedding; empty retrieval skips generation.&lt;/div&gt;" source="retriever/retrieve.py · ask.py · ADR 0008 / 0018" tooltip="Source: retriever/retrieve.py · ask.py · ADR 0008 / 0018">
          <mxCell style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=16;fontFamily=Helvetica;fontColor=#172B4D;" vertex="1" parent="1">
