        <mxCell id="u13label" value="11  Complete job → done" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontColor=#087F8C;fontStyle=0;spacing=0;" vertex="1" parent="1">
