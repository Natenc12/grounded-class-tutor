+++ b/tests/gct/grounder/test_quotes.py
@@ -0,0 +1,122 @@
+"""Hand-written cases for the verbatim-quote verifier. No model, no database."""
+
+from __future__ import annotations
+
+from gct.grounder.quotes import Evidence, check_evidence, locate, split_evidence
+
+SLIDE = (
+    "Cosmogony today: Evolution or Creation?\n"
+    "“Creation Science” reinterprets scientific results to argue that various myths in the "
+    "Book of Genesis and other select biblical passages are scientifically valid."
+)
+CRITIQUE = (
+    "Creation Science is not a science but a religious belief of a very specific kind. Its "
+    "advocates have adopted a statement of faith."
+)
+SOURCES = {1: CRITIQUE, 2: SLIDE}
+
+
+def reasons(evidence, cited, sources=SOURCES):
+    return check_evidence(evidence, cited, sources).reasons
+
+
+class TestLocate:
+    def test_exact_quote_is_found_and_the_span_slices_the_source(self):
+        span = locate("reinterprets scientific results to argue", SLIDE)
+        assert SLIDE[span[0] : span[1]] == "reinterprets scientific results to argue"
+
+    def test_case_punctuation_whitespace_and_quote_style_do_not_matter(self):
+        assert locate('"creation science"  REINTERPRETS\nscientific   results', SLIDE)
+
+    def test_one_changed_word_is_not_a_quote(self):
+        assert locate("reinterprets scientific findings to argue", SLIDE) is None
+
+    def test_a_dropped_negation_is_not_a_quote(self):
+        assert locate("Creation Science is a science", CRITIQUE) is None
+
+    def test_reordered_words_are_not_a_quote(self):
+        assert locate("scientific results reinterprets", SLIDE) is None
+
+    def test_ellipsis_joins_fragments_that_appear_in_order(self):
+        span = locate("reinterprets scientific results ... are scientifically valid", SLIDE)
+        assert SLIDE[span[0] : span[1]].endswith("scientifically valid")
+
+    def test_ellipsis_fragments_out_of_order_fail(self):
+        assert locate("are scientifically valid … reinterprets scientific results", SLIDE) is None
+
+    def test_a_quote_cannot_be_stitched_across_two_sources(self):
+        assert locate("a religious belief ... are scientifically valid", CRITIQUE) is None
+
+
+class TestCheckEvidence:
+    def test_a_real_quote_from_the_cited_source_passes(self):
+        check = check_evidence(
+            [Evidence(2, "reinterprets scientific results to argue")], [2], SOURCES
+        )
+        assert check.reasons == []
+        assert check.verified[0].text == "reinterprets scientific results to argue"
+
+    def test_a_fabricated_quote_fails(self):
+        assert reasons([Evidence(2, "claims the earth is six thousand years old")], [2]) == [
+            "quote attributed to [S2] does not appear in that source",
+            "[S2] is cited with no verified quote from that source",
+        ]
+
+    def test_a_real_quote_pinned_on_the_wrong_source_names_the_right_one(self):
+        [first, _] = reasons([Evidence(2, "not a science but a religious belief")], [2])
+        assert first == (
+            "quote attributed to [S2] does not appear in that source; those words are in [S1] "
+            "instead"
+        )
+
+    def test_a_citation_with_no_evidence_fails(self):
+        assert reasons([Evidence(2, "reinterprets scientific results to argue")], [1, 2]) == [
+            "[S1] is cited with no verified quote from that source"
+        ]
+
+    def test_a_two_word_quote_is_too_short_to_be_evidence(self):
+        [first, _] = reasons([Evidence(2, "Creation Science")], [2])
+        assert first.startswith("quote attributed to [S2] is 2 word(s)")
+
+    def test_a_source_shorter_than_the_minimum_can_be_quoted_whole(self):
+        assert check_evidence([Evidence(1, "Nine days.")], [1], {1: "Nine days."}).reasons == []
+
+    def test_evidence_for_a_label_that_was_never_provided_fails(self):
+        assert reasons([Evidence(7, "reinterprets scientific results to argue")], []) == [
+            "evidence names [S7], which was not among the sources provided"
+        ]
+
+    def test_shown_text_comes_from_the_source_not_from_the_model(self):
+        check = check_evidence(
+            [Evidence(2, "CREATION SCIENCE reinterprets scientific")], [2], SOURCES
+        )
+        assert check.verified[0].text == "Creation Science” reinterprets scientific"
+
+
+class TestSplitEvidence:
+    def test_block_is_cut_out_and_the_coverage_line_survives(self):
+        raw = (
+            "It reinterprets results [S2].\n"
+            "EVIDENCE:\n"
+            '[S2] "reinterprets scientific results to argue"\n'
+            "COVERAGE: complete"
+        )
+        text, evidence, malformed = split_evidence(raw)
+        assert text == "It reinterprets results [S2].\nCOVERAGE: complete"
+        assert evidence == [Evidence(2, "reinterprets scientific results to argue")]
+        assert malformed == []
+
+    def test_a_reply_with_no_block_is_returned_untouched(self):
+        assert split_evidence("Prose [S1].\nCOVERAGE: complete") == (
+            "Prose [S1].\nCOVERAGE: complete",
+            [],
+            [],
+        )
+
+    def test_an_unquoted_evidence_line_is_reported_not_guessed_at(self):
+        _, evidence, malformed = split_evidence("P [S1].\nEVIDENCE:\n[S1] no quotes here\n")
+        assert evidence == [] and malformed == ["[S1] no quotes here"]
+
+    def test_inner_quotation_marks_are_kept(self):
+        _, [item], _ = split_evidence('P [S2].\nEVIDENCE:\n[S2] "“Creation Science” reinterprets"')
+        assert item.quote == "“Creation Science” reinterprets"
