@@ -0,0 +1,166 @@
+"""Verbatim-quote verification: a citation must come with words that are really on that page.
+
+PROTOTYPE. The model ends its reply with an evidence block, one line per supporting quote:
+
+    EVIDENCE:
+    [S1] "exact words copied from source 1"
+    [S3] "exact words copied ... from source 3"
+
+Code then checks, with no model, that each quote is a run of consecutive words in the source it
+is attributed to. A quote that is not there fails; a quote that is there but in a DIFFERENT
+source is named as such. What the student is shown is cut from the stored source text at the
+matched span, never the model's own string, so displayed evidence has never passed through a
+model.
+
+This does not prove the prose means what the quote says. It narrows what is left to check from
+"does this 250-word chunk support this answer" to "does this sentence say that".
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+MIN_QUOTE_WORDS = 4
+
+_EVIDENCE_HEADER_RE = re.compile(r"^[ \t]*EVIDENCE[ \t]*:[ \t]*$", re.IGNORECASE | re.M)
+_EVIDENCE_LINE_RE = re.compile(r'^\[S(?P<ordinal>\d+)\][ \t]*["“](?P<quote>.+)["”]$')
+_WORD_RE = re.compile(r"[^\W_]+")
+_ELLIPSIS_RE = re.compile(r"\.{3,}|…")
+
+
+@dataclass(frozen=True)
+class Evidence:
+    ordinal: int
+    quote: str
+
+
+@dataclass(frozen=True)
+class VerifiedQuote:
+    ordinal: int
+    text: str  # sliced from the SOURCE, not from the model's reply
+    start: int
+    end: int
+
+
+@dataclass(frozen=True)
+class EvidenceCheck:
+    verified: list[VerifiedQuote]
+    reasons: list[str]
+
+
+def split_evidence(raw: str) -> tuple[str, list[Evidence], list[str]]:
+    """Cut the evidence block out of a reply: (reply without it, evidence, malformed lines).
+
+    The block runs from the `EVIDENCE:` line to the next line that is not an evidence line, so a
+    trailing `COVERAGE:` line stays in the returned text for the existing parser.
+    """
+    header = _EVIDENCE_HEADER_RE.search(raw)
+    if header is None:
+        return raw, [], []
+    evidence: list[Evidence] = []
+    malformed: list[str] = []
+    rest: list[str] = []
+    lines = raw[header.end() :].splitlines()
+    for position, line in enumerate(lines):
+        stripped = line.strip()
+        if not stripped:
+            continue
+        match = _EVIDENCE_LINE_RE.match(stripped)
+        if match:
+            evidence.append(Evidence(int(match.group("ordinal")), match.group("quote")))
+        elif stripped.startswith("[S"):
+            malformed.append(stripped)
+        else:
+            rest = lines[position:]
+            break
+    return "\n".join([raw[: header.start()].rstrip(), *rest]), evidence, malformed
+
+
+def _words(text: str) -> list[tuple[str, int, int]]:
+    """Comparable words with their character span in `text`.
+
+    Case, punctuation, whitespace and quote style are not evidence, so they do not count: a word
+    is a run of letters or digits, compared after Unicode compatibility folding.
+    """
+    return [
+        (unicodedata.normalize("NFKC", m.group()).casefold(), m.start(), m.end())
+        for m in _WORD_RE.finditer(text)
+    ]
+
+
+def _find(needle: Sequence[str], haystack: Sequence[str], start: int) -> int | None:
+    for at in range(start, len(haystack) - len(needle) + 1):
+        if haystack[at : at + len(needle)] == list(needle):
+            return at
+    return None
+
+
+def locate(quote: str, source: str) -> tuple[int, int] | None:
+    """The character span of `quote` in `source`, or None if its words are not there in order.
+
+    An ellipsis in the quote joins fragments: each must appear, in order, in the same source.
+    The span covers from the first fragment's first word to the last fragment's last word.
+    """
+    source_words = _words(source)
+    haystack = [word for word, _, _ in source_words]
+    cursor = 0
+    first: int | None = None
+    last = 0
+    for fragment in _ELLIPSIS_RE.split(quote):
+        needle = [word for word, _, _ in _words(fragment)]
+        if not needle:
+            continue
+        at = _find(needle, haystack, cursor)
+        if at is None:
+            return None
+        first = at if first is None else first
+        last = at + len(needle) - 1
+        cursor = last + 1
+    if first is None:
+        return None
+    return source_words[first][1], source_words[last][2]
+
+
+def check_evidence(
+    evidence: Sequence[Evidence],
+    cited: Sequence[int],
+    sources: Mapping[int, str],
+    *,
+    min_words: int = MIN_QUOTE_WORDS,
+) -> EvidenceCheck:
+    """Verify every quote against the source it names, and that every cited source has one."""
+    verified: list[VerifiedQuote] = []
+    reasons: list[str] = []
+    for item in evidence:
+        label = f"[S{item.ordinal}]"
+        source = sources.get(item.ordinal)
+        if source is None:
+            reasons.append(f"evidence names {label}, which was not among the sources provided")
+            continue
+        span = locate(item.quote, source)
+        if span is None:
+            elsewhere = sorted(o for o, text in sources.items() if locate(item.quote, text))
+            where = (
+                f"; those words are in {', '.join(f'[S{o}]' for o in elsewhere)} instead"
+                if elsewhere
+                else ""
+            )
+            reasons.append(f"quote attributed to {label} does not appear in that source{where}")
+            continue
+        quoted_words = len(_words(_ELLIPSIS_RE.sub(" ", item.quote)))
+        if quoted_words < min(min_words, len(_words(source))):
+            reasons.append(
+                f"quote attributed to {label} is {quoted_words} word(s); at least {min_words} "
+                "are needed to count as evidence"
+            )
+            continue
+        verified.append(VerifiedQuote(item.ordinal, source[span[0] : span[1]], *span))
+
+    supported = {quote.ordinal for quote in verified}
+    for ordinal in sorted(set(cited) - supported):
+        if ordinal in sources:
+            reasons.append(f"[S{ordinal}] is cited with no verified quote from that source")
+    return EvidenceCheck(verified=verified, reasons=reasons)
