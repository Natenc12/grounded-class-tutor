diff --git a/tests/gct/grounder/test_answer_quotes.py b/tests/gct/grounder/test_answer_quotes.py
new file mode 100644
index 0000000..b3e17ba
--- /dev/null
+++ b/tests/gct/grounder/test_answer_quotes.py
@@ -0,0 +1,104 @@
+"""`answer(..., require_quotes=True)`: a citation without a real quote can never be GROUNDED."""
+
+from __future__ import annotations
+
+from gct.grounder.answer import GrounderState, answer
+from gct.providers.standin import StandInGeneration
+from gct.retriever.retrieve import RetrievedChunk
+
+
+def chunk(n: int, text: str, file: str = "hydrology.pdf") -> RetrievedChunk:
+    return RetrievedChunk(chunk_id=f"chunk-{n}", text=text, file=file, page_or_slide=n, score=0.9)
+
+
+RETRIEVED = [
+    chunk(1, "Residence time in the atmosphere is about nine days. In a lake it can be years."),
+    chunk(2, "A watershed is the area of land that drains to a single outlet.", "policy.pdf"),
+]
+
+
+def reply(evidence: str) -> str:
+    return (
+        "Water stays in the atmosphere for about nine days [S1].\n"
+        f"EVIDENCE:\n{evidence}\nCOVERAGE: complete"
+    )
+
+
+def ask(scripted, *replies: str):
+    return answer(
+        "How long?", RETRIEVED, "owner-1", generator=scripted(*replies), require_quotes=True
+    )
+
+
+def test_a_verbatim_quote_grounds_and_the_citation_carries_the_source_text(scripted):
+    result = ask(scripted, reply('[S1] "residence time in the atmosphere is about NINE days"'))
+
+    assert result.state is GrounderState.GROUNDED
+    assert result.citations[0].quotes == ("Residence time in the atmosphere is about nine days",)
+    assert "EVIDENCE" not in result.answer_prose
+
+
+def test_a_fabricated_quote_is_retried_then_flagged_never_grounded(scripted):
+    fabricated = reply('[S1] "residence time in the atmosphere is about ninety days"')
+
+    result = ask(scripted, fabricated, fabricated)
+
+    assert result.state is GrounderState.INTEGRITY_FLAGGED
+    assert "quote attributed to [S1] does not appear in that source" in result.integrity.reasons
+
+
+def test_a_quote_from_the_other_file_does_not_support_this_citation(scripted):
+    wrong_file = reply('[S1] "the area of land that drains to a single outlet"')
+
+    result = ask(scripted, wrong_file, wrong_file)
+
+    assert result.state is GrounderState.INTEGRITY_FLAGGED
+    assert "those words are in [S2] instead" in result.integrity.reasons[0]
+
+
+def test_a_citation_with_no_evidence_block_at_all_is_flagged(scripted):
+    bare = "Water stays in the atmosphere for about nine days [S1].\nCOVERAGE: complete"
+
+    result = ask(scripted, bare, bare)
+
+    assert result.state is GrounderState.INTEGRITY_FLAGGED
+    assert result.integrity.reasons == ["[S1] is cited with no verified quote from that source"]
+
+
+def test_a_bad_quote_then_a_good_one_recovers_on_the_single_retry(scripted):
+    result = ask(
+        scripted,
+        reply('[S1] "made up words that are not there"'),
+        reply('[S1] "is about nine days"'),
+    )
+
+    assert result.state is GrounderState.GROUNDED
+
+
+def test_a_refusal_needs_no_evidence(scripted):
+    result = ask(scripted, "COVERAGE: gaps: how long water stays in the atmosphere")
+
+    assert result.state is GrounderState.REFUSAL
+
+
+def test_the_prompt_asks_for_evidence_only_when_quotes_are_required(scripted):
+    with_quotes = scripted(reply('[S1] "is about nine days"'))
+    answer("q", RETRIEVED, "o", generator=with_quotes, require_quotes=True)
+    without = scripted("Nine days [S1].\nCOVERAGE: complete")
+    answer("q", RETRIEVED, "o", generator=without)
+
+    assert "EVIDENCE:" in with_quotes.calls[0][0]["content"]
+    assert "EVIDENCE:" not in without.calls[0][0]["content"]
+
+
+def test_the_stand_in_model_satisfies_the_contract_end_to_end():
+    result = answer(
+        "How long is residence time in the atmosphere?",
+        RETRIEVED,
+        "owner-1",
+        generator=StandInGeneration(),
+        require_quotes=True,
+    )
+
+    assert result.state is GrounderState.GROUNDED
+    assert result.citations[0].quotes == ("Residence time in the atmosphere is about nine days",)
