+++ b/src/gct/providers/replay.py
@@ -0,0 +1,230 @@
+"""Record a provider's real responses once; replay them for free ever after.
+
+PROTOTYPE. Two wrappers per interface, above the provider seam (ADR 0013), so they work for any
+provider: `Recording*` calls the wrapped provider and writes what it said to a cassette (a JSONL
+file meant to be committed); `Replay*` answers from the cassette and never touches a network.
+
+The cache key is a hash of the request itself: the model id plus the exact messages (or text).
+The messages contain the system prompt and the retrieved, chunked, labelled sources, so a change
+to the prompt, the model id, the chunking, the retrieval or the corpus changes the key. Replay
+then has no answer and raises `ReplayMiss`, saying which of those moved. Nothing can change what
+the model is asked without a fresh recording being made on purpose.
+
+One request may hold several responses, replayed in order: the grounder retries with identical
+messages, and a recording made with repeats keeps every sample.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import struct
+from collections import defaultdict
+from collections.abc import Sequence
+from pathlib import Path
+
+from gct.providers.base import Embeddings, Generation, Message
+
+GENERATE = "generate"
+EMBED = "embed"
+
+
+class ReplayMiss(RuntimeError):
+    """Replay was asked something the cassette does not hold. A re-record is needed."""
+
+
+def _sha(value: object) -> str:
+    canonical = json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":"))
+    return hashlib.sha256(canonical.encode()).hexdigest()
+
+
+def generate_key(model_id: str, messages: Sequence[Message]) -> str:
+    return _sha([GENERATE, model_id, [[m["role"], m["content"]] for m in messages]])
+
+
+def embed_key(model_id: str, dim: int, text: str) -> str:
+    return _sha([EMBED, model_id, dim, text])
+
+
+def _pack(vector: Sequence[float]) -> str:
+    return base64.b64encode(struct.pack(f"<{len(vector)}f", *vector)).decode()
+
+
+def _unpack(packed: str) -> list[float]:
+    raw = base64.b64decode(packed)
+    return list(struct.unpack(f"<{len(raw) // 4}f", raw))
+
+
+class Cassette:
+    """Recorded responses, one JSON object per line, in the order they were recorded."""
+
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+        self.entries: list[dict] = []
+        if self.path.exists():
+            lines = self.path.read_text(encoding="utf-8").splitlines()
+            self.entries = [json.loads(line) for line in lines if line.strip()]
+        self._by_key: dict[str, list[dict]] = defaultdict(list)
+        for entry in self.entries:
+            self._by_key[entry["key"]].append(entry)
+        self._cursor: dict[str, int] = defaultdict(int)
+
+    def add(self, entry: dict) -> None:
+        self.entries.append(entry)
+        self._by_key[entry["key"]].append(entry)
+
+    def has(self, key: str) -> bool:
+        return key in self._by_key
+
+    def first(self, key: str) -> dict | None:
+        held = self._by_key.get(key)
+        return held[0] if held else None
+
+    def next(self, key: str) -> dict | None:
+        held = self._by_key.get(key, [])
+        position = self._cursor[key]
+        if position >= len(held):
+            return None
+        self._cursor[key] = position + 1
+        return held[position]
+
+    def of_kind(self, kind: str) -> list[dict]:
+        return [entry for entry in self.entries if entry["kind"] == kind]
+
+    def save(self) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        lines = [json.dumps(e, sort_keys=True, ensure_ascii=False) for e in self.entries]
+        self.path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+class RecordingGeneration:
+    def __init__(self, inner: Generation, cassette: Cassette) -> None:
+        self._inner = inner
+        self._cassette = cassette
+
+    @property
+    def model_id(self) -> str:
+        return self._inner.model_id
+
+    def generate(self, messages: Sequence[Message]) -> str:
+        response = self._inner.generate(messages)
+        self._cassette.add(
+            {
+                "kind": GENERATE,
+                "key": generate_key(self.model_id, messages),
+                "model_id": self.model_id,
+                "system_sha": _sha([m["content"] for m in messages if m["role"] == "system"]),
+                "response": response,
+            }
+        )
+        return response
+
+
+class ReplayGeneration:
+    """`misses` is how a caller finds out: the grounder turns ANY exception from `generate` into
+    a returned ERROR state (ADR 0016), so a `ReplayMiss` raised here never reaches the caller as
+    an exception. A replay run must end with `misses == []`.
+    """
+
+    def __init__(self, model_id: str, cassette: Cassette) -> None:
+        self._model_id = model_id
+        self._cassette = cassette
+        self.misses: list[str] = []
+
+    @property
+    def model_id(self) -> str:
+        return self._model_id
+
+    def generate(self, messages: Sequence[Message]) -> str:
+        key = generate_key(self._model_id, messages)
+        entry = self._cassette.next(key)
+        if entry is not None:
+            return entry["response"]
+        self.misses.append(self._why(key, messages))
+        raise ReplayMiss(self.misses[-1])
+
+    def _why(self, key: str, messages: Sequence[Message]) -> str:
+        recorded = self._cassette.of_kind(GENERATE)
+        remedy = f"Re-record {self._cassette.path} against the real models, and commit it."
+        if self._cassette.has(key):
+            return (
+                "this exact request was made more times than it was recorded (an extra retry, "
+                f"or more repeats than the recording holds). {remedy}"
+            )
+        models = sorted({entry["model_id"] for entry in recorded})
+        if self._model_id not in models:
+            return (
+                f"no answer was ever recorded from the model {self._model_id!r}; the recording "
+                f"holds {models}. If the model id was changed on purpose: {remedy}"
+            )
+        system_sha = _sha([m["content"] for m in messages if m["role"] == "system"])
+        if system_sha not in {entry["system_sha"] for entry in recorded}:
+            return f"the system prompt differs from the one that was recorded. {remedy}"
+        return (
+            "the question or the sources handed to the model differ from what was recorded "
+            f"(chunking, retrieval, k, embeddings or the corpus changed). {remedy}"
+        )
+
+
+class RecordingEmbeddings:
+    """Returns the vector exactly as replay will return it (32-bit), so both runs rank alike."""
+
+    def __init__(self, inner: Embeddings, cassette: Cassette) -> None:
+        self._inner = inner
+        self._cassette = cassette
+
+    @property
+    def model_id(self) -> str:
+        return self._inner.model_id
+
+    @property
+    def dim(self) -> int:
+        return self._inner.dim
+
+    def embed(self, texts: Sequence[str]) -> list[list[float]]:
+        out: list[list[float]] = []
+        for text, vector in zip(texts, self._inner.embed(texts), strict=True):
+            key = embed_key(self.model_id, self.dim, text)
+            packed = _pack(vector)
+            if not self._cassette.has(key):
+                self._cassette.add(
+                    {"kind": EMBED, "key": key, "model_id": self.model_id, "vector": packed}
+                )
+            out.append(_unpack(packed))
+        return out
+
+
+class ReplayEmbeddings:
+    def __init__(self, model_id: str, dim: int, cassette: Cassette) -> None:
+        self._model_id = model_id
+        self._dim = dim
+        self._cassette = cassette
+
+    @property
+    def model_id(self) -> str:
+        return self._model_id
+
+    @property
+    def dim(self) -> int:
+        return self._dim
+
+    def embed(self, texts: Sequence[str]) -> list[list[float]]:
+        out: list[list[float]] = []
+        for text in texts:
+            entry = self._cassette.first(embed_key(self._model_id, self._dim, text))
+            if entry is None:
+                models = sorted({e["model_id"] for e in self._cassette.of_kind(EMBED)})
+                why = (
+                    f"no vector was ever recorded from the model {self._model_id!r}; the "
+                    f"recording holds {models}"
+                    if self._model_id not in models
+                    else "this text was never embedded in the recording (the chunking, the "
+                    "corpus or a question changed)"
+                )
+                raise ReplayMiss(
+                    f"{why}: {text[:60]!r}. Re-record {self._cassette.path} against the real "
+                    "models, and commit it."
+                )
+            out.append(_unpack(entry["vector"]))
+        return out
diff --git a/tests/gct/providers/test_replay.py b/tests/gct/providers/test_replay.py
