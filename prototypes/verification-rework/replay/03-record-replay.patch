index 0000000..d09b100
--- /dev/null
+++ b/tests/gct/providers/test_replay.py
@@ -0,0 +1,248 @@
+"""Record with the free stand-in models, replay with no model at all, through the real read path.
+
+What this proves is the mechanism: the same wrappers go round the real OpenAI providers
+unchanged. Each test that expects `ReplayMiss` is one of the changes that today passes the
+merge check unnoticed.
+"""
+
+from __future__ import annotations
+
+import uuid
+
+import pytest
+
+from gct.ask import ask
+from gct.classes import create_class
+from gct.eval.scoring import EvalRecord, compute_metrics
+from gct.grounder import answer as grounder
+from gct.grounder.answer import GrounderState
+from gct.ingest.chunk import chunk_units
+from gct.ingest.index import index_file
+from gct.ingest.parse import ParsedUnit
+from gct.ingest.pipeline import PreparedChunk
+from gct.providers.replay import (
+    Cassette,
+    RecordingEmbeddings,
+    RecordingGeneration,
+    ReplayEmbeddings,
+    ReplayGeneration,
+    ReplayMiss,
+)
+from gct.providers.standin import StandInEmbeddings, StandInGeneration
+
+PAGES = [
+    ParsedUnit(
+        "Residence time is how long, on average, a water molecule stays in one part of the "
+        "cycle. In the atmosphere it is about nine days. In a large lake it can be years.",
+        "hydrology-lecture-01.pdf",
+        1,
+    ),
+    ParsedUnit(
+        "A watershed is the area of land that drains to a single outlet. Ridges divide one "
+        "watershed from the next.",
+        "hydrology-lecture-01.pdf",
+        2,
+    ),
+    ParsedUnit(
+        "Groundwater is water held in the pores of rock and sediment below the surface. An "
+        "aquifer is a body of rock porous enough to store useful quantities of it.",
+        "hydrology-lecture-02.pdf",
+        1,
+    ),
+    ParsedUnit(
+        "Water policy: a basin cannot be budgeted without knowing what flows in and out of it. "
+        "Where withdrawals exceed recharge, water tables fall and wells go dry.",
+        "policy-slides.pptx",
+        3,
+    ),
+]
+
+QUESTIONS = [
+    ("in-1", "How long is residence time in the atmosphere?", "answer"),
+    ("in-2", "What is a watershed, and what divides one watershed from the next?", "answer"),
+    ("in-3", "What is an aquifer in groundwater?", "answer"),
+    ("out-1", "What were the main causes of the French Revolution?", "refuse"),
+    ("out-2", "How does photosynthesis convert sunlight into sugar?", "refuse"),
+]
+
+
+def build_class(db, embedder, name, **chunking):
+    conn, owner_id, _ = db
+    conn.commit()  # a read on this connection leaves a transaction open; writers refuse that
+    class_id = create_class(conn, owner_id=owner_id, name=name)
+    chunks = chunk_units(PAGES, **chunking)
+    vectors = embedder.embed([chunk.text for chunk in chunks])
+    by_file: dict[str, list[PreparedChunk]] = {}
+    for chunk, vector in zip(chunks, vectors, strict=True):
+        by_file.setdefault(chunk.file, []).append(
+            PreparedChunk(
+                text=chunk.text,
+                file=chunk.file,
+                page_or_slide=chunk.page_or_slide,
+                embedding=vector,
+                owner_id=owner_id,
+                class_id=class_id,
+                embedding_model_id=embedder.model_id,
+            )
+        )
+    for filename, prepared in by_file.items():
+        index_file(
+            conn,
+            file_id=str(uuid.uuid4()),
+            filename=filename,
+            owner_id=owner_id,
+            class_id=class_id,
+            chunks=prepared,
+        )
+    return class_id
+
+
+def run_suite(db, class_id, embedder, generator):
+    conn, owner_id, _ = db
+    return {
+        qid: ask(conn, question, owner_id, class_id, embedder=embedder, generator=generator)
+        for qid, question, _ in QUESTIONS
+    }
+
+
+def summary(results):
+    return {
+        qid: (
+            r.result.state,
+            r.result.answer_prose,
+            [(c.file, c.page_or_slide) for c in r.result.citations],
+            [(c.file, c.page_or_slide, round(c.score, 5)) for c in r.retrieved],
+        )
+        for qid, r in results.items()
+    }
+
+
+@pytest.fixture
+def recorded(db, tmp_path):
+    """A cassette recorded from the stand-in models, and what the suite returned while recording."""
+    cassette = Cassette(tmp_path / "eval.jsonl")
+    embedder = RecordingEmbeddings(StandInEmbeddings(), cassette)
+    generator = RecordingGeneration(StandInGeneration(), cassette)
+    results = run_suite(db, build_class(db, embedder, "recorded"), embedder, generator)
+    cassette.save()
+    return cassette.path, summary(results)
+
+
+def replayers(path, *, embed_model=StandInEmbeddings.model_id, model=StandInGeneration.model_id):
+    cassette = Cassette(path)
+    return (
+        ReplayEmbeddings(embed_model, StandInEmbeddings.dim, cassette),
+        ReplayGeneration(model, cassette),
+    )
+
+
+def test_replay_reproduces_the_recorded_run_with_no_model_present(db, recorded):
+    path, recorded_summary = recorded
+    embedder, generator = replayers(path)
+
+    replayed = run_suite(db, build_class(db, embedder, "replayed"), embedder, generator)
+
+    assert summary(replayed) == recorded_summary
+    assert generator.misses == []
+    metrics = compute_metrics(
+        [EvalRecord(expectation, replayed[qid].result.state) for qid, _, expectation in QUESTIONS]
+    )
+    assert metrics.grounded_pass_rate == 1.0
+    assert metrics.correct_refusal_rate == 1.0
+
+
+def test_a_misspelled_generation_model_id_cannot_replay(db, recorded):
+    path, _ = recorded
+    embedder, generator = replayers(path, model="standin-quoted-sentense-v1")
+    class_id = build_class(db, embedder, "replayed")
+
+    result = ask(db[0], QUESTIONS[0][1], db[1], class_id, embedder=embedder, generator=generator)
+
+    assert result.result.state is GrounderState.ERROR
+    assert "no answer was ever recorded from the model" in generator.misses[0]
+
+
+def test_a_misspelled_embedding_model_id_cannot_replay(db, recorded):
+    path, _ = recorded
+    embedder, _ = replayers(path, embed_model="standin-hashed-wrods-v1")
+
+    with pytest.raises(ReplayMiss, match="no vector was ever recorded from the model"):
+        build_class(db, embedder, "replayed")
+
+
+def test_an_edited_system_prompt_cannot_replay(db, recorded, monkeypatch):
+    path, _ = recorded
+    embedder, generator = replayers(path)
+    class_id = build_class(db, embedder, "replayed")
+    monkeypatch.setattr(
+        grounder,
+        "_SYSTEM_PROMPT",
+        grounder._SYSTEM_PROMPT.replace(
+            "Never add facts from outside them", "You may add well-known facts from outside them"
+        ),
+    )
+
+    result = ask(db[0], QUESTIONS[0][1], db[1], class_id, embedder=embedder, generator=generator)
+
+    assert result.result.state is GrounderState.ERROR
+    assert "the system prompt differs" in generator.misses[0]
+
+
+def test_a_changed_chunk_window_cannot_replay(db, recorded):
+    path, _ = recorded
+    embedder, _ = replayers(path)
+
+    with pytest.raises(ReplayMiss, match="never embedded in the recording"):
+        build_class(db, embedder, "replayed", size=12, overlap=2)
+
+
+def test_a_changed_k_cannot_replay(db, recorded):
+    path, _ = recorded
+    embedder, generator = replayers(path)
+    class_id = build_class(db, embedder, "replayed")
+
+    conn, owner_id, _ = db
+    result = ask(
+        conn, QUESTIONS[0][1], owner_id, class_id, embedder=embedder, generator=generator, k=2
+    )
+
+    assert result.result.state is GrounderState.ERROR
+    assert "the sources handed to the model differ" in generator.misses[0]
+
+
+def test_repeated_identical_requests_replay_in_recorded_order(tmp_path):
+    class Flaky:
+        model_id = "m"
+
+        def __init__(self):
+            self.replies = ["no marker at all", "Fine [S1].\nCOVERAGE: complete"]
+
+        def generate(self, messages):
+            return self.replies.pop(0)
+
+    cassette = Cassette(tmp_path / "c.jsonl")
+    recorder = RecordingGeneration(Flaky(), cassette)
+    messages = [{"role": "system", "content": "s"}, {"role": "user", "content": "u"}]
+    recorder.generate(messages), recorder.generate(messages)
+    cassette.save()
+
+    replay = ReplayGeneration("m", Cassette(cassette.path))
+
+    assert replay.generate(messages) == "no marker at all"
+    assert replay.generate(messages) == "Fine [S1].\nCOVERAGE: complete"
+    with pytest.raises(ReplayMiss, match="more times than it was recorded"):
+        replay.generate(messages)
+
+
+def test_the_recorded_suite_is_what_the_stand_ins_should_produce(recorded):
+    _, recorded_summary = recorded
+
+    states = {qid: row[0] for qid, row in recorded_summary.items()}
+
+    assert states == {
+        "in-1": GrounderState.GROUNDED,
+        "in-2": GrounderState.GROUNDED,
+        "in-3": GrounderState.GROUNDED,
+        "out-1": GrounderState.REFUSAL,
+        "out-2": GrounderState.REFUSAL,
+    }
