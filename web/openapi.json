{
  "openapi": "3.1.0",
  "info": {
    "title": "Grounded Class Tutor",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/classes": {
      "post": {
        "tags": [
          "classes"
        ],
        "operationId": "create_classes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewClass"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/files": {
      "post": {
        "tags": [
          "files"
        ],
        "operationId": "upload_file_files_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_files_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/files/{file_id}": {
      "get": {
        "tags": [
          "files"
        ],
        "operationId": "file_status_files__file_id__get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "ask"
        ],
        "operationId": "ask_question_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "class_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "class_id",
          "question"
        ]
      },
      "AskResponse": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "GROUNDED",
              "PARTIAL",
              "REFUSAL",
              "INTEGRITY_FLAGGED"
            ]
          },
          "answer_prose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageOut"
          },
          "integrity": {
            "$ref": "#/components/schemas/IntegrityOut"
          }
        },
        "type": "object",
        "required": [
          "state",
          "answer_prose",
          "citations",
          "coverage",
          "integrity"
        ]
      },
      "Body_upload_file_files_post": {
        "properties": {
          "class_id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream"
          }
        },
        "type": "object",
        "required": [
          "class_id",
          "file"
        ]
      },
      "CitationOut": {
        "properties": {
          "label": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "page_or_slide": {
            "type": "integer"
          },
          "chunk_id": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "label",
          "file",
          "page_or_slide",
          "chunk_id"
        ]
      },
      "ClassCreated": {
        "properties": {
          "class_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "class_id",
          "name"
        ]
      },
      "CoverageOut": {
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "complete",
          "gaps"
        ]
      },
      "FileStatusResponse": {
        "properties": {
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "failed_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "status",
          "failed_reason",
          "message"
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "IntegrityOut": {
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "reasons"
        ]
      },
      "NewClass": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ]
      },
      "UploadAccepted": {
        "properties": {
          "file_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "filename"
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array"
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "input": {},
          "ctx": {
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ]
      }
    }
  }
}
